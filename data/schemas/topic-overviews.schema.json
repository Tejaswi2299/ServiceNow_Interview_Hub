{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic-overviews.schema.json",
  "title": "Topic overview entry",
  "type": "object",
  "required": [
    "topicId",
    "verified",
    "definition",
    "whatItDoes",
    "tablesInvolved",
    "keyComponents",
    "realTimeExamples",
    "interviewPitfalls",
    "trickyComparisonSupport",
    "officialSources"
  ],
  "properties": {
    "topicId": { "type": "string", "minLength": 1 },
    "verified": { "type": "boolean" },
    "definition": { "type": "string", "minLength": 1 },
    "whatItDoes": { "type": "string", "minLength": 1 },
    "tablesInvolved": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "keyComponents": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "realTimeExamples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "interviewPitfalls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "trickyComparisonSupport": { "type": "boolean" },
    "officialSources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
